/dts-v1/;

/ {
	compatible = "amazon,azma11";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Amazon Lab126, Azma11 PDL-Mini";

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0x00 0x06 0x00>;
		compatible = "simple-bus";

		nna-rd-pprobe@0a2107800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "nna_rd_pprobe";
			reg = <0x00>;
			counters = <0x08>;
			filters = <0x04>;
			filter-mask = <0x79f>;
		};

		nna-wr-pprobe@0a2108800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "nna_wr_pprobe";
			reg = <0x01>;
			counters = <0x08>;
			filters = <0x04>;
			filter-mask = <0x79f>;
		};

		lsio-audio-dma-pprobe@a230d800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "lsio_audio_dma_pprobe";
			reg = <0x02>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		lsio-pprobe@a230e800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "lsio_pprobe";
			reg = <0x03>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		audio-ss-rd-pprobe@a2600000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "audio_ss_rd_pprobe";
			reg = <0x04>;
			counters = <0x08>;
			filters = <0x01>;
			filter-mask = <0x79f>;
		};

		cpuss0-rd-pprobe@a2600800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "cpuss0_rd_pprobe";
			reg = <0x05>;
			counters = <0x08>;
			filters = <0x01>;
			filter-mask = <0x79f>;
		};

		cpuss0-wr-pprobe@a2601000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "cpuss0_wr_pprobe";
			reg = <0x06>;
			counters = <0x08>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		cpuss1-pprobe@a2601800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "cpuss1_pprobe";
			reg = <0x07>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		crypto-pprobe@a2602000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "crypto_pprobe";
			reg = <0x08>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		mcuss0-pprobe@a2603400 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "mcuss0_pprobe";
			reg = <0x09>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		mcuss1-pprobe@a2603c00 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "mcuss1_pprobe";
			reg = <0x0a>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		wifisdio-pprobe@a2604400 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "wifisdio_pprobe";
			reg = <0x0b>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		audio-ss-wr-pprobe@a2608000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "audio_ss_wr_pprobe";
			reg = <0x0c>;
			counters = <0x08>;
			filters = <0x01>;
			filter-mask = <0x79f>;
		};

		emmc-pprobe@a2a00000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "emmc_pprobe";
			reg = <0x0d>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		nand-pprobe@a2a01000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "nand_pprobe";
			reg = <0x0e>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		securityss-pprobe@a2a01800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "securityss_pprobe";
			reg = <0x0f>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		usb0-pprobe@a2a02000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "usb0_pprobe";
			reg = <0x10>;
			counters = <0x0a>;
			filters = <0x02>;
			filter-mask = <0x79f>;
		};

		memnoc-port0-rd-pprobe@a9002000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p0_rd_pprobe";
			reg = <0x11>;
			counters = <0x01>;
			countersz = <0x20>;
			filters = <0x01>;
			filter-mask = <0x80001b9f>;
			read-probe;
		};

		memnoc-port0-wr-pprobe@a9002800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p0_wr_pprobe";
			reg = <0x12>;
			counters = <0x01>;
			countersz = <0x20>;
			filters = <0x01>;
			filter-mask = <0x80001b9f>;
			write-probe;
		};

		memnoc-port1-rd-pprobe@a9003000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p1_rd_pprobe";
			reg = <0x13>;
			counters = <0x01>;
			countersz = <0x20>;
			filters = <0x01>;
			filter-mask = <0x80001b9f>;
			read-probe;
		};

		memnoc-port1-wr-pprobe@a9003800 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p1_wr_pprobe";
			reg = <0x14>;
			counters = <0x01>;
			countersz = <0x20>;
			filters = <0x01>;
			filter-mask = <0x80001b9f>;
			write-probe;
		};

		memnoc-port2-rd-pprobe0@a90004000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p2_rd_pprobe0";
			reg = <0x15>;
			counters = <0x05>;
			countersz = <0x20>;
			filters = <0x03>;
			filter-mask = <0x80001b9f>;
			read-probe;
		};

		memnoc-port2-rd-pprobe1@a90004400 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p2_rd_pprobe1";
			reg = <0x16>;
			counters = <0x04>;
			countersz = <0x20>;
			filters = <0x03>;
			filter-mask = <0x80001b9f>;
			read-probe;
		};

		memnoc-port2-wr-pprobe0@a9004c00 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p2_wr_pprobe0";
			reg = <0x17>;
			counters = <0x05>;
			countersz = <0x20>;
			filters = <0x03>;
			filter-mask = <0x80001b9f>;
			write-probe;
		};

		memnoc-port2-wr-pprobe1@a9005000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_p2_wr_pprobe1";
			reg = <0x18>;
			counters = <0x04>;
			countersz = <0x20>;
			filters = <0x03>;
			filter-mask = <0x80001b9f>;
			write-probe;
		};

		memnoc-dficam-pprobe@a9402000 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_dficam_pprobe";
			reg = <0x19>;
			counters = <0x18>;
			countersz = <0x12>;
			filters = <0x00>;
			filter-mask = <0x00>;
			event-probe;
		};

		memnoc-dfimc-pprobe@a9402400 {
			compatible = "amazon,azma-noc-pmu";
			probe-name = "memnoc_dfimc_pprobe";
			reg = <0x1a>;
			counters = <0x10>;
			countersz = <0x12>;
			filters = <0x00>;
			filter-mask = <0x00>;
			event-probe;
		};

		hifi-ipc {
			compatible = "amazon,dsp-host-driver";
			memory-region = <0x02>;
			regmap-mailbox = <0x03>;
			mboxes = <0x04 0x200 0x100 0x01 0x04 0x800 0x400 0x01 0x04 0x20000 0x10000 0x01 0x04 0x80000 0x40000 0x00>;
			mbox-names = "hifi1_ch0\0hifi1_ch1\0hifi5_ch0\0hifi5_ch1";
			reg = <0x00 0x8b00002c 0x00 0x14 0x00 0x8b000018 0x00 0x14 0x00 0x8b000ba0 0x00 0x08>;
			reg-names = "HIFI1_DSP_MEMORY\0HIFI5_DSP_MEMORY\0HIFI5_DSP_ERRATA_MEMORY";
			phandle = <0x05>;

			hifi-core@1 {
				amzn,core-id = <0x01>;
			};

			hifi-core@5 {
				errata-bus-addr = <0x00 0x18000000>;
				amzn,core-id = <0x05>;
			};
		};

		hifidai@0 {
			compatible = "amazon,hifi1-dais";
			#sound-dai-cells = <0x00>;
			hifi,ipc = <0x05>;
			reg = <0x00 0x8007afe0 0x00 0x20>;
			counter = <0x06>;
		};

		snd-hifi {
			compatible = "amazon,azma-rproc-hifi";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			resets = <0x07 0x02>;
			ranges;
			machine = <0x0b>;
			clocks = <0x08 0x0e 0x08 0x10 0x08 0x13>;
			clock-names = "i2s0-sclk\0i2s2-sclk\0tdm0-sclk";
			regmap-lsio-dmac = <0x09>;
			regmap-apb = <0x0a>;
			regmap-i2s0 = <0x0b>;
			regmap-tdm0 = <0x0c>;

			hifi-core-1 {
				compatible = "amazon,hifi-core-1";
				reg = <0x00 0x8b060000 0x00 0x10000 0x00 0x8b070000 0x00 0x10000>;
				reg-names = "IRAM_MEMORY\0DRAM0_MEMORY";
				hifi,ipc = <0x05>;
				amzn,core-id = <0x01>;
				firmware-name = "dsp_hifi1.elf";
				interrupts = <0x00 0x2e 0x04>;
				regmap-wdt = <0x0d>;
			};

			hifi-core-5 {
				compatible = "amazon,hifi-core-5";
				reg = <0x00 0x18000000 0x00 0x3c00000 0x00 0x8e000000 0x00 0x2000000 0x00 0x80000000 0x00 0x80000>;
				reg-names = "DRAM0_MEMORY\0DRAM1_MEMORY\0SRAM_MEMORY";
				hifi,ipc = <0x05>;
				amzn,core-id = <0x05>;
				firmware-name = "dsp_hifi5.elf";
				interrupts = <0x00 0x2f 0x04>;
				regmap-wdt = <0x0e>;
			};
		};

		adc {
			compatible = "amazon,azma-adc";
			reg = <0x00 0xb00e8200 0x00 0x100>;
			channel-count = <0x06>;
			hwlocks = <0x0f 0x00>;
		};

		spinlock {
			compatible = "amazon,azma-hwspinlock";
			reg = <0x00 0xa0000008 0x00 0x40>;
			#hwlock-cells = <0x01>;
			num-sems = <0x10>;
			phandle = <0x0f>;
		};

		amazon,scmi-vendor-rtc {
			compatible = "amazon,scmi-vendor-rtc";
			domain-id = <0x02>;
		};

		amazon,scmi-vendor-pwrbutton {
			compatible = "amazon,scmi-vendor-pwrbutton";
			domain-id = <0x01>;
			status = "okay";
		};

		amazon,scmi-vendor-ddrc {
			compatible = "amazon,scmi-vendor-ddrc";
			domain-id = <0x06>;
		};

		amazon,scmi-vendor-scp-stats {
			compatible = "amazon,scmi-vendor-scp-stats";
			domain-id = <0x03>;
			memory-region = <0x10>;
			companion-pmic-status = <0x00>;
		};

		gpio-range {
			#svp-gpio-range-cells = <0x03>;
			phandle = <0x11>;
		};

		amazon,scmi-vendor-pinctrl@b00d0000 {
			compatible = "amazon,scmi-vendor-pinctrl";
			reg = <0x00 0xb00d0000 0x00 0x248>;
			#pinctrl-cells = <0x01>;
			bytes-per-pin = <0x08>;
			#gpio-range-cells = <0x03>;
			domain-id = <0x00>;
			svp-gpio-range = <0x11 0x02 0x01 0x00 0x11 0x05 0x04 0x00 0x11 0x09 0x09 0x05 0x11 0x12 0x01 0x00 0x11 0x13 0x08 0x05 0x11 0x1b 0x03 0x00 0x11 0x1e 0x04 0x05 0x11 0x23 0x02 0x05 0x11 0x25 0x02 0x00 0x11 0x27 0x0b 0x05 0x11 0x32 0x02 0x00 0x11 0x37 0x08 0x00 0x11 0x3f 0x04 0x05 0x11 0x43 0x06 0x00>;
			phandle = <0x18>;

			led_pwr_pins {
				svp-pins = <0x228 0x00>;
				svp,bias-pullup;
			};

			rotary_pin_a {
				svp-pins = <0x180 0x0d>;
				svp,bias-high-impedance;
			};

			rotary_pin_b {
				svp-pins = <0x188 0x0d>;
				svp,bias-high-impedance;
			};

			adc_reset {
				svp-pins = <0x198 0x00>;
				svp,bias-pullup;
				phandle = <0x1c>;
			};

			i2c3_pins {
				svp-pins = <0x118 0x10 0x120 0x10>;
			};

			i2c8_pins {
				svp-pins = <0x238 0x11 0x240 0x11>;
				svp,bias-pullup;
			};

			gpio_privacy_btn_irq {
				svp-pins = <0x1d8 0x08>;
				svp,bias-pullup;
				phandle = <0x46>;
			};

			primary_cpld_irq {
				svp-pins = <0x218 0x08>;
				svp,bias-pullup;
			};

			spi3_pins {
				svp-pins = <0xb8 0x00 0xc0 0x00 0xc8 0x08 0xd0 0x00>;
			};

			zb_gpios {
				svp-pins = <0xe0 0x00 0x1b8 0x08>;
			};

			gpio_zb_reset {
				svp-pins = <0xd8 0x00>;
				svp,bias-pullup;
				phandle = <0x20>;
			};
		};

		amazon,scmi-vendor-pinctrl@b00e0000 {
			compatible = "amazon,scmi-vendor-pinctrl";
			reg = <0x00 0xb00e0000 0x00 0x170>;
			#pinctrl-cells = <0x01>;
			bytes-per-pin = <0x08>;
			#gpio-range-cells = <0x03>;
			domain-id = <0x00>;
			svp-gpio-range = <0x11 0x00 0x04 0x05 0x11 0x08 0x06 0x05 0x11 0x0e 0x01 0x00 0x11 0x10 0x01 0x05 0x11 0x11 0x03 0x00 0x11 0x16 0x06 0x05 0x11 0x27 0x01 0x05 0x11 0x28 0x02 0x00>;
			phandle = <0x17>;

			i2c0_pins {
				svp-pins = <0x18 0x11 0x10 0x11>;
				svp,bias-pullup;
			};

			i2c1_pins {
				svp-pins = <0x40 0x10 0x48 0x10>;
			};

			i2c2_pins {
				svp-pins = <0x00 0x10 0x08 0x10>;
				phandle = <0x1e>;
			};

			i2c2_gpio_pins {
				svp-pins = <0x00 0x15 0x08 0x15>;
			};

			gpio_privacy_mute_pwm {
				svp-pins = <0x80 0x00>;
				svp,bias-pullup;
			};

			gpio_privacy_default {
				svp-pins = <0x98 0x00>;
				svp,bias-pulldown;
				phandle = <0x44>;
			};

			gpio_privacy_sta_irq {
				svp-pins = <0x88 0x08>;
				svp,bias-pullup;
				phandle = <0x45>;
			};
		};

		amazon,scmi-vendor-pinctrl@b00f0000 {
			compatible = "amazon,scmi-vendor-pinctrl";
			reg = <0x00 0xb00f0000 0x00 0x70>;
			#pinctrl-cells = <0x01>;
			bytes-per-pin = <0x08>;
			#gpio-range-cells = <0x03>;
			domain-id = <0x00>;
			svp-gpio-range = <0x11 0x00 0x01 0x00 0x11 0x01 0x07 0x05>;
			phandle = <0x16>;
		};

		amazon,boot-kpi@1e912000 {
			compatible = "amazon,boot-kpi";
			reg = <0x00 0x1e912000 0x00 0x1000 0x00 0x00 0x00 0x0a 0x00 0x0a 0x00 0x0a 0x00 0x14 0x00 0x0a 0x00 0x1e 0x00 0x0e 0x00 0x2c 0x00 0x0a 0x00 0x36 0x00 0x0a>;
			reg-names = "boot-kpi-base\0bl2_idx\0bl31_idx\0bl32_idx\0bl33_idx\0scp_idx\0aon_idx";
			counter-freq = <0x16e3600>;
			counter = <0x06>;
			status = "disabled";
		};

		amazon,logger {
			compatible = "amazon,logger";
			memory-region = <0x12>;
			memory-region-names = "aonlpi";
		};

		syscon@B2100000 {
			compatible = "syscon";
			reg = <0x00 0xb2100000 0x00 0x1000>;
			phandle = <0x0b>;
		};

		syscon@B2130000 {
			compatible = "syscon";
			reg = <0x00 0xb2130000 0x00 0x1000>;
			phandle = <0x0c>;
		};

		syscon@B2009000 {
			compatible = "syscon";
			reg = <0x00 0xb2009000 0x00 0x04>;
			phandle = <0x0a>;
		};

		syscon@b21a0000 {
			compatible = "syscon";
			reg = <0x00 0xb21a0000 0x00 0x10000>;
			phandle = <0x09>;
		};

		syscon@A0005000 {
			compatible = "syscon";
			reg = <0x00 0xa0005000 0x00 0x1000>;
			phandle = <0x0d>;
		};

		amazon,azma-carm-clocks {
			compatible = "amazon,azma-dummycc";
			clock-output-names = "carm_clocks";
			#clock-cells = <0x01>;
			status = "disabled";
		};

		amazon,azma-acl-mpu@a9402000 {
			compatible = "amazon,azma-acl-mpu";
			reg = <0x00 0xa9402000 0x00 0x1000>;
			status = "disabled";
		};

		interrupt-controller@86000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			interrupt-controller;
			reg = <0x00 0x86000000 0x00 0x10000 0x00 0x86040000 0x00 0xc00000>;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;
		};

		amazon,nna@8c001000 {
			compatible = "amazon,nna-2.0";
			interrupt-names = "nna_interrupt";
			interrupts = <0x00 0x06 0x01>;
			reg = <0x00 0x8c001000 0x00 0x1000>;
			clock-names = "nna_clk";
			clocks = <0x08 0x0c>;
			operating-points-v2 = <0x13>;
			vdd-supply = <0x14>;
			reserved;
		};

		opp-table-nna {
			compatible = "operating-points-v2";
			phandle = <0x13>;

			opp-0 {
				opp-hz = <0x00 0x5f5e100>;
			};

			opp-1 {
				opp-hz = <0x00 0xbebc200>;
			};

			opp-2 {
				opp-hz = <0x00 0x17d78400>;
			};

			opp-4 {
				opp-hz = <0x00 0x2faf0800>;
			};
		};

		mailbox@a0000000 {
			compatible = "amazon,azma-mailbox";
			reg = <0x00 0xa0000000 0x00 0x1000>;
			regmap-soc-mailbox = <0x03>;
			#mbox-cells = <0x03>;
			status = "okay";
			phandle = <0x04>;

			chan1 {
				tx_mask = <0x02>;
				rx_mask = <0x01>;
				interrupts = <0x00 0x37 0x04>;
				interrupt-names = "no-suspend-irq";
				atomic-rx;
			};

			chan9 {
				tx_mask = <0x200>;
				rx_mask = <0x100>;
				interrupts = <0x00 0x3f 0x04>;
			};

			chan11 {
				tx_mask = <0x800>;
				rx_mask = <0x400>;
				interrupts = <0x00 0x41 0x04>;
				atomic-rx;
			};

			chan17 {
				tx_mask = <0x20000>;
				rx_mask = <0x10000>;
				interrupts = <0x00 0x47 0x04>;
				interrupt-names = "wake-irq";
				atomic-rx;
			};

			chan19 {
				tx_mask = <0x80000>;
				rx_mask = <0x40000>;
				interrupts = <0x00 0x49 0x04>;
				interrupt-names = "wake-irq";
				atomic-rx;
			};

			chan23 {
				tx_mask = <0x800000>;
				rx_mask = <0x400000>;
