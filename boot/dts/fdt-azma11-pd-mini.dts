	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			clocks = <0x2e 0x00>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x2f 0x30>;
			phandle = <0x37>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			clocks = <0x2e 0x00>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x2f 0x30>;
			phandle = <0x38>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x200>;
			clocks = <0x2e 0x00>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x2f 0x30>;
			phandle = <0x39>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x300>;
			clocks = <0x2e 0x00>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x2f 0x30>;
			phandle = <0x3a>;
		};
	};

	idle-states {
		entry-method = "psci";

		cpu-sleep {
			compatible = "arm,idle-state";
			idle-state-name = "core-power-down";
			arm,psci-suspend-param = <0x10000>;
			entry-latency-us = <0xfa>;
			exit-latency-us = <0xfa>;
			min-residency-us = <0x1f4>;
			local-timer-stop;
			phandle = <0x2f>;
		};

		cluster-sleep {
			compatible = "arm,idle-state";
			idle-state-name = "cluster-power-down";
			arm,psci-suspend-param = <0x1010000>;
			entry-latency-us = <0x12c>;
			exit-latency-us = <0xfa>;
			min-residency-us = <0x9c4>;
			local-timer-stop;
			phandle = <0x30>;
		};
	};

	audio-pre-machine {
		compatible = "amazon,audio-pre-machine";
		num-gpio = <0x00>;
		sequence;
	};

	hifi-cpu {
		compatible = "amazon,hifi-cpu";
		#sound-dai-cells = <0x00>;
		phandle = <0x33>;
	};

	hifi-dsp {
		compatible = "amazon,azma-sndcard";
		model = "azma-snd-card";
		azma,routing = "DSP CODEC IN\0AIF1 Capture\0Codec Playback\0AIF_TAS5805m_A\0Out Speaker\0TAS5805m_A Playback";
		amp-en-gpio = <0x31 0x0c 0x00>;
		stby-gpio = <0x21 0x12 0x00>;

		dai_link@1 {
			link-name = "Internal Playback";
			atomic;

			cpu {
				dai-name = "Internal_Playback";
			};
		};

		dai_link@2 {
			link-name = "Lineout Playback";
			atomic;

			cpu {
				dai-name = "Lineout_Playback";
			};
		};

		dai_link@3 {
			link-name = "A2DP Ref Playback";
			atomic;

			cpu {
				dai-name = "A2DP_Ref_Playback";
			};
		};

		dai_link@4 {
			link-name = "ASR Capture";
			dynamic;

			cpu {
				dai-name = "DSP_ASR_STREAM";
			};
		};

		dai_link@5 {
			link-name = "VOIP Capture";
			dynamic;

			cpu {
				dai-name = "DSP_VOIP_STREAM";
			};
		};

		dai_link@6 {
			link-name = "DC Capture";
			dynamic;

			cpu {
				dai-name = "DSP_DC_STREAM";
			};
		};

		dai_link@7 {
			link-name = "SWW Capture";
			dynamic;

			cpu {
				dai-name = "DSP_SWW_STREAM";
			};
		};

		dai_link@8 {
			link-name = "BT_HFP_STREAM";
			atomic;

			cpu {
				sound-dai = <0x32>;
			};
		};

		dai_link@100 {
			link-name = "Playback Codec";
			c2c;

			cpu {
				sound-dai = <0x33>;
			};
		};

		dai_link@9 {
			link-name = "Capture Codec";
			no_pcm;
			dummy_cpu;

			codec-0 {
				dai-name = "tlv320adc5140";
				sound-dai = <0x34>;
			};
		};

		dai_link@10 {
			link-name = "DBG Capture";
			dynamic;

			cpu {
				dai-name = "DSP_DBG_STREAM";
			};
		};

		dai_link@11 {
			link-name = "TAP Capture";
			dynamic;

			cpu {
				dai-name = "DSP_TAP_STREAM";
			};
		};

		dai_link@12 {
			link-name = "RAD Capture";
			dynamic;

			cpu {
				dai-name = "DSP_RAD_STREAM";
			};
		};

		dai_link@13 {
			link-name = "USBB Capture";
			dynamic;

			cpu {
				dai-name = "DSP_USBB_STREAM";
			};
		};

		dai_link@14 {
			link-name = "MMSF Capture";
			dynamic;

			cpu {
				dai-name = "DSP_MMSF_STREAM";
			};
		};

		dai_link@15 {
			link-name = "Playback Codec15";
			c2c;

			cpu {
				sound-dai = <0x33>;
			};

			codec-0 {
				dai-name = "tas5805m-a";
				sound-dai = <0x35>;
			};
		};
	};

	hifi1-debug-log {
		compatible = "amazon,azma-hifi1-debug";
		buf-size = <0x2000>;
		buf-name = "LOG_MEMORY";
		hifi,ipc = <0x05>;
		buf-type = <0x00>;
	};

	hifi1-debug-dump {
		compatible = "amazon,azma-hifi1-debug";
		buf-size = <0x200000>;
		buf-name = "DUMP_MEMORY";
		hifi,ipc = <0x05>;
		buf-type = <0x01>;
	};

	hifi1_log_device {
		compatible = "amazon,hifi1-log-reserved-memory";
		memory-region = <0x36>;
		status = "okay";
	};

	syscon@A0006000 {
		compatible = "syscon";
		reg = <0x00 0xa0006000 0x00 0x1000>;
		phandle = <0x0e>;
	};

	adf-dsp {
		compatible = "amazon,adf-dsp-driver";
		total-dsp-cores = <0x02>;
		msg-delayed-read = <0x01>;
		module-is-dependency;

		dependent-modules {

			module_hifi1 {
				module-name = "hifi-core-1";
				is-of-match = <0x01>;
			};

			module_hifi5 {
				module-name = "hifi-core-5";
				is-of-match = <0x01>;
			};
		};

		pcm_dai_links {

			adf_asr_dai_link {
				link-name = "DSP_ASR_STREAM";
				stream-name = "ASR Capture";
			};

			adf_voip_dai_link {
				link-name = "DSP_VOIP_STREAM";
				stream-name = "VOIP Capture";
			};

			adf_dc_dai_link {
				link-name = "DSP_DC_STREAM";
				stream-name = "DC Capture";
			};

			adf_sww_dai_link {
				link-name = "DSP_SWW_STREAM";
				stream-name = "SWW Capture";
			};

			adf_dbg_dai_link {
				link-name = "DSP_DBG_STREAM";
				stream-name = "DBG Capture";
			};

			adf_tap_dai_link {
				link-name = "DSP_TAP_STREAM";
				stream-name = "TAP Capture";
			};

			adf_rad_dai_link {
				link-name = "DSP_RAD_STREAM";
				stream-name = "RAD Capture";
			};

			adf_usbb_dai_link {
				link-name = "DSP_USBB_STREAM";
				stream-name = "USBB Capture";
			};

			adf_mmsf_dai_link {
				link-name = "DSP_MMSF_STREAM";
				stream-name = "MMSF Capture";
			};
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x04>;
	};

	dsu-pmu {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0xff 0x04>;
		cpus = <0x37 0x38 0x39 0x3a>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	rproc@1fff000 {
		compatible = "amazon,azma-rproc-optee";
		reg = <0x00 0x1fff000 0x00 0xf00 0x00 0x8a801000 0x00 0x1000>;
		reg-names = "rsc_table\0mcu_ss_sensorhub";
		mcuss-aonlpi-pc = <0x14>;
		interrupts = <0x00 0x2d 0x04>;
		ssr-name = "aon-lpi";
		firmware-name = "aonlpi_fw.fit";
		wakeup-source;
		auto-boot;
		azma-rproc-part = <0x00>;
		mboxes = <0x04 0x800000 0x400000 0x00>;
		memory-region = <0x3b 0x3c 0x3d>;
		status = "okay";
	};

	syscon@a000a000 {
		compatible = "syscon";
		reg = <0x00 0xa000a000 0x00 0x2000>;
		phandle = <0x3e>;
	};

	amazon,azma-glb-timer@a000a000 {
		compatible = "amazon,azma-glb-timer";
		regmap-glb-timer = <0x3e>;
		interrupts = <0x00 0x32 0x04>;
		timer-instance = <0x01>;
		clocks = <0x3f>;
		clock-names = "refclk";
		status = "okay";
	};

	amazon,azma-glb-timer-cnt@a000a000 {
		compatible = "amazon,azma-glb-timer-cnt";
		regmap-glb-timer-cnt = <0x3e>;
		clocks = <0x3f>;
		clock-names = "refclk";
		phandle = <0x06>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	clocks {

		clk@24000000 {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x16e3600>;
			clock-output-names = "refclk";
			phandle = <0x3f>;
		};

		clk100000000 {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x5f5e100>;
			clock-output-names = "sysclk";
			phandle = <0x19>;
		};

		clk200000000 {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xbebc200>;
			clock-output-names = "sdioclk";
		};

		nfclk20000000 {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xe4e1c00>;
			clock-output-names = "nfclk";
			phandle = <0x15>;
		};
	};

	firmware {

		scmi {
			compatible = "arm,scmi";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			mboxes = <0x04 0x02 0x01 0x00 0x04 0x8000000 0x4000000 0x00>;
			mbox-names = "tx\0rx";
			shmem = <0x40 0x41>;
			status = "okay";

			protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <0x01>;
			};

			protocol@13 {
				reg = <0x13>;
				#clock-cells = <0x01>;
				phandle = <0x2e>;
			};

			protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x08>;
			};

			protocol@15 {
				reg = <0x15>;
				#thermal-sensor-cells = <0x01>;
				sensor-poll-address = <0x1e9103a8>;
				sensor-poll-size = <0x100>;
				phandle = <0x42>;
			};

			protocol@16 {
				reg = <0x16>;
				#reset-cells = <0x01>;
				phandle = <0x07>;
			};

			protocol@17 {
				reg = <0x17>;

				regulators {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					scmi_regul_npu@0 {
						reg = <0x00>;
						regulator-name = "scmi_npu_regul";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x149970>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x14>;
					};
				};
			};

			protocol@99 {
				reg = <0x99>;
			};
		};
	};

	ddr-devfreq {
		compatible = "amazon,azma-ddrc-devfreq";
		clocks = <0x2e 0x01>;
		status = "disabled";
	};

	syscon@A0000000 {
		compatible = "syscon";
		reg = <0x00 0xa0000000 0x00 0x1000>;
		phandle = <0x03>;
	};

	azma-reboot-reason {
		compatible = "amazon,azma-reboot-reason";
		domain-id = <0x04>;
		regmap-reboot-reason = <0x03>;
		status = "okay";
	};

	noc_trace {
		compatible = "amazon,azma-noc-trace";
		reg = <0x00 0xa2606b00 0x00 0x10 0x00 0xa2607500 0x00 0x10 0x00 0xa2107800 0x00 0x400 0x00 0xa2108800 0x00 0x400 0x00 0xa230d800 0x00 0x400 0x00 0xa230e800 0x00 0x400 0x00 0xa2600000 0x00 0x400 0x00 0xa2600800 0x00 0x400 0x00 0xa2601000 0x00 0x400 0x00 0xa2601800 0x00 0x400 0x00 0xa2602000 0x00 0x400 0x00 0xa2603400 0x00 0x400 0x00 0xa2603c00 0x00 0x400 0x00 0xa2604400 0x00 0x400 0x00 0xa2608000 0x00 0x400 0x00 0xa2a00000 0x00 0x400 0x00 0xa2a01000 0x00 0x400 0x00 0xa2a01800 0x00 0x400 0x00 0xa2a02000 0x00 0x400 0x00 0xa9002000 0x00 0x400 0x00 0xa9002800 0x00 0x400 0x00 0xa9003000 0x00 0x400 0x00 0xa9003800 0x00 0x400 0x00 0xa9004000 0x00 0x400 0x00 0xa9004400 0x00 0x400 0x00 0xa9004c00 0x00 0x400 0x00 0xa9005000 0x00 0x400>;
		reg-names = "atb\0stp\0nna_ss_rd\0nna_ss_wr\0audiodma\0lsio\0audio\0cpu0_rd\0cpu0_wr\0cpu1\0crypto\0aonlpi\0scp\0wifi\0audio_wr\0emmc\0onfi\0sec_ss\0usb0\0memnoc_p0_rd\0memnoc_p0_wr\0memnoc_p1_rd\0memnoc_p1_wr\0memnoc_p2_rd0\0memnoc_p2_rd1\0memnoc_p2_wr0\0memnoc_p2_wr1";
	};

	errlog {
		compatible = "amazon,azma-noc-errlog";
		interrupts = <0x00 0x1a 0x04 0x00 0x1c 0x04 0x00 0x20 0x04>;
	};

	cpucore-cooling {
		compatible = "amazon,azma-thermal-cooling";
		cpu-mask = <0x0f>;
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3a98>;
			thermal-sensors = <0x42 0x00>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		memss-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3a98>;
			thermal-sensors = <0x42 0x01>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		audio-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3a98>;
			thermal-sensors = <0x42 0x02>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		soc-max-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3a98>;
			thermal-sensors = <0x42 0x03>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};
	};

	aliases {
		serial0 = "/soc/uart@b2010000";
		i2c0 = "/i2c-aonlpi-ipc";
		i2c1 = "/soc/i2c@b2001000";
		i2c2 = "/soc/i2c@b2002000";
		i2c5 = "/soc/i2c@b2005000";
	};

	chosen {
		linux,usable-memory-range = <0x00 0x2000000 0x00 0x3e000000>;
		bootargs = "console=ttyS0,921600n8 earlycon=uart8250,mmio32,0xb2010000 keepinitrd kvm-arm.mode=nvhe pd_ignore_unused cpuidle.off=1 reboot=w";
		stdout-path = "serial0:921600n8";
	};

	sdio_vddo_ctrl {
		compatible = "regulator-gpio";
		regulator-name = "sdio_vddo_ctrl_reg";
		regulator-type = "voltage";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		states = <0x00 0x00 0x325aa0 0x01>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-us = <0x1388>;
		phandle = <0x1a>;
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x21 0x02 0x01>;
		phandle = <0x1b>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		status = "okay";

		button@0 {
			debounce-interval = <0x32>;
			label = "volume up";
			linux,input-type = <0x01>;
			linux,code = <0x73>;
			gpios = <0x21 0x15 0x11>;
			swdebounce-interval = <0x64>;
			dyndebounce-interval = <0x00>;
			dyndebounce-duration = <0x2710>;
		};

		button@1 {
			debounce-interval = <0x32>;
			label = "volume down";
			linux,input-type = <0x01>;
			linux,code = <0x72>;
			gpios = <0x21 0x16 0x11>;
			fastboot-gpio = <0x43 0x11 0x11>;
			swdebounce-interval = <0x64>;
			dyndebounce-interval = <0x00>;
			dyndebounce-duration = <0x2710>;
		};
	};

	gpio-privacy {
		compatible = "gpio-privacy";
		pinctrl-names = "default";
		pinctrl-0 = <0x44 0x45 0x46>;
		status = "okay";
		enable-gpio = <0x47 0x06 0x00>;
		enable-gpio-toggle-duration = <0x3e8>;
		auto-toggle-enable-gpio-time = <0x32>;
		privacy-event-max-press-duration = <0xbb8>;

		state_event {
			label = "mute state";
			linux,input-type = <0x05>;
			linux,code = <0x0e>;
			gpios = <0x47 0x04 0x01>;
		};

		button_event {
			label = "mute";
			linux,input-type = <0x01>;
			linux,code = <0x74>;
			debounce-interval = <0x00>;
			wakeup-source;
			gpios = <0x21 0x14 0x01>;
		};
	};

	fixedregulator@3 {
		compatible = "regulator-fixed";
		regulator-name = "reset_adc";
		gpios = <0x47 0x07 0x00>;
		startup-delay-us = <0x2710>;
		enable-active-high;
		status = "okay";
		phandle = <0x1d>;
	};

	i2c-aonlpi-ipc {
		compatible = "amazon,aonlpi-pseudo-i2c";
		#address-cells = <0x00>;
		#size-cells = <0x00>;
		amazon,aonlpi_ipc_pdev = <0x48>;
		status = "okay";
		clock-frequency = <0x61a80>;

		lp5018@28 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "ti,lp5018";
			reg = <0x28>;
			max-brightness = <0xc0>;
			dimming-curve = "logarithmic";
			status = "okay";

			led@0 {
				reg = <0x00>;
				label = "ledmod_0";
				ti,led-module = <0x04>;
				rgb-map = [00 01 02];
				linux,default-trigger = "boot-anim";
			};

			led@1 {
				reg = <0x01>;
				label = "ledmod_1";
				ti,led-module = <0x03>;
				rgb-map = [00 01 02];
				linux,default-trigger = "boot-anim";
			};

			led@2 {
				reg = <0x02>;
				label = "ledmod_2";
				ti,led-module = <0x02>;
				rgb-map = [00 01 02];
				linux,default-trigger = "boot-anim";
			};

			led@3 {
				reg = <0x03>;
				label = "ledmod_3";
				ti,led-module = <0x01>;
				rgb-map = [00 01 02];
				linux,default-trigger = "boot-anim";
			};

			led@4 {
				reg = <0x04>;
				label = "ledmod_4";
				ti,led-module = <0x00>;
				rgb-map = [00 01 02];
				linux,default-trigger = "boot-anim";
			};
		};
	};

	soc_max_virtual_sensor {
		compatible = "amazon,virtual_sensor";
		#thermal-sensor-cells = <0x00>;

		zone-list {
			zone-names = "soc-max-thermal";
			soc-max-thermal = <0x00 0x00 0x3e8 0x3e8 0x00 0x00>;
		};
	};
};
