        embedded-script = "\nfunction get_device_image_version_timestamp()\n    local f=io.open('/etc/os-release', r)\n    local s=f:read('*all')\n    f:close()\n    _, _ , version = string.find(s, 'VERSION_NUMBER=\\\"(%d+)\\\"')\n    _, _ , timestamp = string.find(s, 'BUILD_TIMESTAMP=\\\"(%d+)\\\"')\n    return tonumber(version),tonumber(timestamp)\nend\n\nfunction do_version_check(image)\n    device_version, device_timestamp=get_device_image_version_timestamp()\n    image_version=tonumber('7202000014820')\n    image_timestamp=tonumber('1793127430')\n    if image_version > device_version and image_timestamp >= device_timestamp then\n        print('version check done')\n        return true, image\n    else\n        print('version check failed')\n        print(image_version, image_timestamp, device_version, device_timestamp)\n        return false, image\n    end\nend\nfunction get_secboot_value()\n    local f = io.open('/sys/firmware/devicetree/base/chosen/secboot_enabled', 'r')\n    if not f then\n        return nil, 'File does not exist'\n    end\n    local value = f:read('*all')\n    f:close()\n    return value\nend\n\nfunction do_secure_soc_check(image)\n    -- result: if nill skip the specific image update\n    -- success: if false abort entire update operation\n    local result = nil\n    local success = true\n    local secboot_enabled = '1'\n    secboot_value, err_msg = get_secboot_value()\n    if err_msg then\n        swupdate.error(err_msg)\n        -- abort entire OTA update if secboot_enabled does not exist\n        success = false\n    else\n        if string.find(secboot_value, secboot_enabled) then\n            -- safe to install the image\n            result = image\n        end\n    end\n    return success, result\nend\n\nfunction do_non_secure_soc_check(image)\n    -- result: if nill skip the specific image update\n    -- success: if false abort entire update operation\n    local result = nil\n    local success = true\n    local secboot_disabled = '0