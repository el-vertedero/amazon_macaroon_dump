<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<audio_hwio_configuration version="1.0" xmlns:xi="http://www.w3.org/2001/XInclude">
    <!-- version section contains a tag in the form "major.minor" e.g version="1.0" -->

    <!-- Hardware Modules section, <hw_modules>:
        There is one section, <module>, per audio HAL module present on the platform.
        Each module section will contain attributes of the audio HAL:
        "id" - Mandatory. Helps identify
        "description" - Description of the HAL module
        "version" - Version of the HAL module
        "library" - Library to load. If this is not specified, then the HwIoManager would
                    assume the library name as audio.<module id>.<target>.so

        Each HAL <module> will contain the following child sections:
        <audio_ports>: a list of port descriptors for all different sink/source ports
                       supported by the module.

        <audio_devices>: descriptors of the devices supported by the module. For e.g. Speaker, HDMI, etc.

        <audio_patches>: descriptors for any device to device loopback supported by the module.
                         For e.g. Line In to Speaker, HDMI In to Speaker etc.
    -->
    <hw_modules>
        <!-- Primary Audio HAL -->
        <module id="bleremote" description="BT Remote Audio HAL" version="1.0">
            <!-- library="audio.bleremote.default.so" -->

            <audio_ports>
                <port name="bt-remote input" role="AMAZON_AUDIO_ROLE_SOURCE"
                    flags="AMAZON_AUDIO_FLAG_NONE"
                    devices="BleRemote"
                    periodFrameCount="320"
                    periodCount="1">
                    <config format="AMAZON_AUDIO_FORMAT_PCM_16_BIT"
                            sampleRates="AMAZON_AUDIO_SAMPLE_RATE_16_KHZ"
                            channelMasks="AMAZON_AUDIO_CHANNEL_MONO"/>
                </port>
            </audio_ports>

            <audio_devices>
                <device name="BleRemote" role="AMAZON_AUDIO_ROLE_SOURCE" type="AMAZON_AUDIO_DEVICE_BLUETOOTH_LE_REMOTE" address="">
                </device>
            </audio_devices>

        </module>
    </hw_modules>
    <!-- End of HwModules section -->

</audio_hwio_configuration>
