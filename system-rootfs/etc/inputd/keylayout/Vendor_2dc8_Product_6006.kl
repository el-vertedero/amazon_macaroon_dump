# 8BitDo Pro 2 Controller - Bluetooth (Native mode)

# Mapping according to https://developer.android.com/training/game-controllers/controller-input.html

# A
key 0x130    BUTTON_A
# B
key 0x131    BUTTON_B
# X
key 0x133    BUTTON_X
# Y
key 0x134    BUTTON_Y

# Left Bumper
key 0x136    BUTTON_L1
# Right Bumper
key 0x137    BUTTON_R1

# Left Trigger (digital)
key 0x138    BUTTON_L2
# Right Trigger (digital)
key 0x139    BUTTON_R2

# Left Trigger (analog)
axis 0x0a    BRAKE
# Right Trigger (analog)
axis 0x09    GAS

# Left Analog Stick
axis 0x00    X
axis 0x01    Y
# Right Analog Stick
axis 0x02    Z
axis 0x05    RZ

# Left stick click
key 0x13d    BUTTON_THUMBL
# Right stick click
key 0x13e    BUTTON_THUMBR

# Hat / D-pad
axis 0x10    HAT_X
axis 0x11    HAT_Y

# Mapping according to https://www.kernel.org/doc/Documentation/input/gamepad.txt
# Select / Back
key 0x13a    BUTTON_SELECT
# Start
key 0x13b    BUTTON_START
# Home
key 0x13c    BUTTON_MODE
