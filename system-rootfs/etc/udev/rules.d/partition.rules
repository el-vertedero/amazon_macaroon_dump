# Platform mount UDEV rules
SUBSYSTEM!="block", GOTO="action_end"
DEVPATH!="/devices/platform/*", GOTO="action_end"

ACTION!="add|change", GOTO="action_remove"
PROGRAM="/bin/ls -d /dev/block/platform", GOTO="create_link"
# Create symlink directory if it doesn't exist
RUN+="/bin/mkdir -p /dev/block/platform"
LABEL="create_link"
SYMLINK+="block/platform/%E{PARTNAME}"
GOTO="action_end"

LABEL="action_remove"
ACTION!="remove", GOTO="action_end"
RUN+="/bin/rm /dev/block/platform/%E{PARTNAME}"

LABEL="action_end"
