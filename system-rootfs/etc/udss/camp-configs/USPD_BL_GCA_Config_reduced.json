{
    "description": "USPD Events Receiver - Reduced, omitting range and sensitivity",
    "version": "1.0",
    "CAMPSchemaVersion": "1.0",
    "streams": [
        {
            "name": "uspdGCA_reduced",
            "type": "core.GenericCA",
            "args": {
                "capability": {
                    "discovery": {
                        "type": "AlexaInterface",
                        "interface": "Alexa.MotionSensor",
                        "version": "3.2",
                        "properties": {
                            "supported": [
                                {
                                    "name": "detectionState",
                                    "type": "string",
                                    "default": "NOT_DETECTED"
                                },
                                {
                                    "name": "enablement",
                                    "type": "string",
                                    "default": "DISABLED"
                                },
                                {
                                    "name": "detectionTechnology",
                                    "type": "string",
                                    "default": "ULTRASONIC_BASIC"
                                }
                            ],
                            "proactivelyReported": true,
                            "retrievable": true
                        }
                    },
                    "directives": [
                        {
                            "name": "SetEnablement"
                        }
                    ]
                }
            }
        },
        {
            "name": "USPDEnablementHandler",
            "type": "core.json.accessor",
            "inputs": [
                "GenericCA|Directives|Alexa.MotionSensor|SetEnablement|IPCIn"
            ],
            "args": {
                "accessKey": "directive.payload.enablement"
            }
        },
        {
            "name": "USPDStorage",
            "type": "core.USPDStorage",
            "inputs": [
                "USPDEnablementHandler"
            ]
        },
        {
            "name": "USPDStream",
            "type": "core.USPD",
            "inputs": [
                "USPDStorage"
            ]
        },
        {
            "name": "USPDChangeReportHandler",
            "type": "core.USPDChangeReportHandler",
            "inputs": [
                "USPDStream"
            ]
        },
        {
            "name": "USPDDetectionTechStream",
            "type": "core.USPDDetectionTech"
        },
        {
            "name": "Clear enablement IPCOut Cache upon SetEnablement Directive",
            "type": "core.clearcache",
            "inputs": [
                "GenericCA|Directives|Alexa.MotionSensor|SetEnablement|IPCIn",
                "GenericCA|Properties|Alexa.MotionSensor|enablement|IPCOut"
            ]
        },
        {
            "name": "USPDEnablement directive response event builder",
            "type": "core.avsevents.response",
            "inputs": [
                "GenericCA|Directives|Alexa.MotionSensor|SetEnablement|IPCIn",
                "GenericCA|Properties|Alexa.MotionSensor|enablement|IPCOut"
            ]
        }
    ],
    "exec": [
        {
            "command": "connect",
            "input": "USPDEnablement directive response event builder",
            "consumer": "GenericCA|Events|Alexa.MotionSensor|IPCOut"
        },
        {
            "command": "connect",
            "input": "USPDChangeReportHandler",
            "consumer": "GenericCA|Properties|Alexa.MotionSensor|detectionState|Setting"
        },
        {
            "command": "connect",
            "input": "USPDEnablementHandler",
            "consumer": "GenericCA|Properties|Alexa.MotionSensor|enablement|Setting"
        },
        {
            "command": "connect",
            "input": "USPDDetectionTechStream",
            "consumer": "GenericCA|Properties|Alexa.MotionSensor|detectionTechnology|Setting"
        }
    ]
}