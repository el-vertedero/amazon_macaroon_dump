[Unit]
Description=Start provisionerd application
Conflicts=shutdown.target
After=dbus.socket netsvc.service btmanagerd.service
Wants=dbus.socket

[Service]
ExecStart=/usr/bin/provisionerd
Restart=always
SmackProcessLabel=System

DynamicUser=yes
SupplementaryGroups=aipc kvstore

# Make AIPC visible
ReadWritePaths=/var/lib/data/ace/aipc /var/lib/data/ace/kvstorage/

# Restrict the permitted syscalls
# If an unexpected syscall occurs, return EPERM instead of terminating.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

PrivateDevices=true

#Enable AIPC/IPCN Access
DeviceAllow=/dev/binder rw
BindPaths=-/dev/binder
ReadWritePaths=-/dev/binder

[Install]
WantedBy=multi-user.target
