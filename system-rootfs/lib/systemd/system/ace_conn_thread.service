[Unit]
Description=ACS Connectivity Thread service
After=otbr-agent.service
Wants=service-registrar.service
PartOf=service-registrar.service
StartLimitInterval=10
StartLimitBurst=10

[Service]
User=openthread
Group=openthread
SupplementaryGroups=aipc
SupplementaryGroups=kvstore

ExecStart=/usr/bin/ace_conn_thread_service
Restart=always

SystemCallFilter=@system-service @network-io @file-system
SystemCallErrorNumber=EPERM

# Fortifying the service
PrivateNetwork=true
SmackProcessLabel=System
CapabilityBoundingSet=none
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

#AIPC Binder
DeviceAllow=/dev/binder rw
BindPaths=-/dev/binder
ReadWritePaths=-/dev/binder

[Install]
WantedBy=multi-user.target
