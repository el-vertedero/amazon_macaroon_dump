[Unit]
Description=Acs sensors service
Wants=service-registrar.service
After=service-registrar.service
PartOf=service-registrar.service
Conflicts=shutdown.target

[Service]
ExecStart=/usr/bin/ace_sensorsd
Restart=always

DynamicUser=yes

# Adding service to aipc and system supplementary groups
SupplementaryGroups=aipc input system

# Make input paths visible
ReadWritePaths=-/dev/input
BindPaths=-/dev/input

#Add Smack process label
SmackProcessLabel=System

# Make AIPC visible
ReadWritePaths=/var/lib/data/ace/aipc/

#AIPC Binder
DeviceAllow=/dev/binder rw
BindPaths=-/dev/binder
ReadWritePaths=-/dev/binder

#Fortifying the service
# PrivateNetwork=true           # Exposed due to VTrace
PrivateDevices=true
CapabilityBoundingSet=none
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

