[Unit]
Description=ACR file enroller daemon
After=systemd-journald.service smartbox.service create-binder.service service-registrar.service
Wants=systemd-journald.service smartbox.service service-registrar.service
PartOf=service-registrar.service
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=notify
User=log
Group=log
SmackProcessLabel=System
ReadWritePaths=-/dev/binder
BindPaths=-/dev/binder
DeviceAllow=/dev/binder rw

PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

ExecStart=/usr/bin/acrreportd
Restart=always
TimeoutStartSec=60
TimeoutStopSec=60
WatchdogSec=60

[Install]
WantedBy=sysinit.target

[X-Kepler]
OffersService=com.amazon.acrreport.ipc
