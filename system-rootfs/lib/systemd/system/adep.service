[Unit]
Description=Adep service

[Service]
Type=simple
ExecStart=/usr/bin/adep
DynamicUser=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SmackProcessLabel=System
User=system
Group=system
SupplementaryGroups=aipc

CapabilityBoundingSet=none
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=-/var/lib/data/ace/aipc/ -/sys/firmware/devicetree/base/chosen/ -/sys/fs/smackfs/ -/dev/binder
BindPaths=-/dev/binder
DeviceAllow=/dev/binder rw

[Install]
WantedBy=multi-user.target
Alias=adep.service
