[Unit]
Description=Boot Complete Monitor
After=multi-user.target

[Service]
Type=idle
User=bootmon
Group=bootmon

ExecStart=/usr/bin/bootmon -e
Restart=on-failure
RestartSec=100ms

# Fortifying the service
SmackProcessLabel=System
SupplementaryGroups=log kvstore
CapabilityBoundingSet=none
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Required for KVS
DeviceAllow=/dev/binder rw
BindPaths=-/dev/binder
ReadWritePaths=-/dev/binder

[Install]
WantedBy=kepler-deferred.target
