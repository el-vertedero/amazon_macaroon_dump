# start static IP. IP info will be set into a file

[Unit]
Description=DHCPCD

[Service]
User=net
Group=net
SupplementaryGroups=wifi log
SmackProcessLabel=System::Privileged

CapabilityBoundingSet=CAP_SYS_CHROOT CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BROADCAST CAP_NET_BIND_SERVICE CAP_MAC_OVERRIDE
AmbientCapabilities=CAP_SYS_CHROOT CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BROADCAST CAP_NET_BIND_SERVICE CAP_MAC_OVERRIDE

ProtectControlGroups=true
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelLogs=true
RestrictRealtime=true
LockPersonality=true
ProtectClock=true
ProtectKernelModules=true
RestrictNamespaces=true

EnvironmentFile=/run/static-ip-%i
ExecStart=/sbin/dhcpcd %i -S ip_address=${IP} -S subnet_mask=${MASK} -S routers=${GW} \
                                -S domain_name_servers="${DNS1} ${DNS2}" -AdLK --nobackground
PIDFile = /run/dhcpcd/%i.pid
Restart=always

[Install]
