[Unit]
Description=Hub Core

[Service]
EnvironmentFile=-/etc/halo/common-env
ExecStartPre=+/bin/sh -c '/bin/mkdir -p /var/lib/data/halo/var/log'
ExecStartPre=+/bin/sh -c '/bin/mkdir -p /var/lib/data/halo/var/sqlite'
ExecStartPre=+/bin/chown -R root:halo /var/lib/data/halo
ExecStartPre=+/bin/chmod -R 775 /var/lib/data/halo
ExecStartPre=-/bin/sh -c '/bin/mkdir -p /run/halo/var/run/hub-core'
ExecStartPre=+/bin/chmod -R 775 /run/halo/
ExecStart=/usr/bin/hub-core
Restart=always

User=halo
Group=halo
SupplementaryGroups=system

# Fortifying the service
SmackProcessLabel=System
CapabilityBoundingSet=none
RestrictAddressFamilies=AF_UNIX
RestrictAddressFamilies=AF_INET
RestrictAddressFamilies=AF_INET6
RestrictNamespaces=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
