[Unit]
Description=mt7902_zb_drv_insmod
After=data-ubi-mnt.service
StartLimitInterval=10
StartLimitBurst=2

[Service]
DynamicUser=yes
Group=system
AmbientCapabilities=CAP_SYS_MODULE CAP_SYS_BOOT CAP_SYS_ADMIN CAP_NET_ADMIN
Type=oneshot
ExecStart=/bin/sh /etc/mt7902_zb_drv_insmod.sh
SmackProcessLabel=System
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
