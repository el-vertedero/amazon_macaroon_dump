[Unit]
Description=Start ACS middleware network manager service
After=ace_eventmgr.service kvs_util.service secure_kvs.service
Wants=ace_eventmgr.service service-registrar.service
PartOf=service-registrar.service
Conflicts=shutdown.target

# disable rate limit
StartLimitIntervalSec=0

[Service]
Type=notify
User=wifi
Group=wifi
SupplementaryGroups=net log aipc kvstore reserved_disk

CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SYS_MODULE CAP_NET_ADMIN CAP_NET_RAW CAP_MAC_OVERRIDE CAP_WAKE_ALARM
AmbientCapabilities=CAP_SYS_MODULE CAP_NET_ADMIN CAP_NET_RAW CAP_MAC_OVERRIDE CAP_WAKE_ALARM

# PROJVEGA-105784 enabling seccomp causes netsvc to break when this is enabled
# disabling as workaround for now because having seccomp more important. 
# Need a proper fix for seccomp.
# SystemCallFilter=@system-service
# RestrictSUIDSGID=yes
SystemCallErrorNumber=EPERM

ProtectControlGroups=yes

ExecStart=/usr/bin/netsvc
Restart=always
SmackProcessLabel=System::Privileged

#AIPC Binder
DeviceAllow=/dev/binder rw
BindPaths=-/dev/binder
ReadWritePaths=-/dev/binder

[Install]
WantedBy=multi-user.target

[X-Kepler]
OffersService=com.amazon.network.service
