[Unit]
Description=OpenThread Border Router Agent
Requires=dbus.socket
After=dbus.socket netsvc.service
Wants=avahi-daemon.service
Wants=dbus.service
StartLimitInterval=10
StartLimitBurst=10

[Service]
Type=notify
User=openthread
Group=openthread
SupplementaryGroups=spimux
EnvironmentFile=-/etc/default/otbr-agent
ExecStart=/usr/sbin/otbr-agent $OTBR_AGENT_OPTS
Restart=always
RestartSec=1

RuntimeDirectory=openthread
StateDirectory=openthread

# OTBR agent needs following capabilities to create 'ot0' network interface
# (using '/dev/net/tun') for Thread IP traffic Tx/Rx
# CAP_NET_RAW - use raw and packet sockets
# CAP_NET_ADMIN - Configure network interface, modify routing tables etc.
# CAP_NET_BIND_SERVICE - To bind ports required by Thread or related protocols.
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE

SystemCallFilter=@system-service @network-io @file-system
SystemCallErrorNumber=EPERM

# Fortifying the service
#PrivateNetwork=true    # Exposed to allow initialization using backbone interface (for e.g wlan0)
# OTBR agent needs:
# AF_NETLINK for network interface management and monitoring
# AF_INET6 (IPv6) for Thread network and AF_INET (IPv4) for external network communication
# AF_PACKET to interface with network devices at a low level
#RestrictAddressFamilies=AF_UNIX  # Exposed due to above requirements
SmackProcessLabel=System
RestrictNamespaces=true
NoNewPrivileges=true
PrivateDevices=true
DeviceAllow=/dev/net/tun rw
BindPaths=-/dev/net/tun
ReadWritePaths=-/dev/net/tun
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
