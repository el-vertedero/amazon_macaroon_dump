[Unit]
Description=Rescue OTA Service
Conflicts=shutdown.target
After=eventmgr.service service-registrar.service
Requires=eventmgr.service
Wants= service-registrar.service
PartOf=service-registrar.service

[Service]
ExecStart=/usr/bin/rescueOTAservice
DynamicUser=yes
Restart=on-failure
RestartSec=900s

# Configure watch dog to restart after 120 seconds of inactivity
#WatchdogSec=120

# Further restrict the API subtrees, as most services don't need these.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Restrict the permitted syscalls to a reasonable set used by common system services.
# If an unexpected syscall occurs, return EPERM instead of terminating.
SystemCallFilter=@system-service @basic-io
SystemCallErrorNumber=EPERM

# Required for AIPC
SupplementaryGroups=aipc
ReadWritePaths=/var/lib/data/ace/aipc/

# Required for logging
ReadWritePaths=-/dev/socket -/dev/log
BindPaths=-/dev/socket -/dev/log

DeviceAllow=/dev/binder rw
BindPaths=-/dev/binder
ReadWritePaths=-/dev/binder

# Fortifying the service
# PrivateNetwork=true        # Exposed due to VTrace.
SmackProcessLabel=System
CapabilityBoundingSet=none
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
