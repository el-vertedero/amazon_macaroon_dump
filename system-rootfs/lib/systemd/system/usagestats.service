[Unit]
Description=UsageStats daemon
Conflicts=shutdown.target
After=lifecycle-manager.service service-registrar.service multi-user.target
Requires=minerva.service eventmgr.service

[Service]
ExecStart=/usr/bin/usagestatsd
SmackProcessLabel=System
DynamicUser=yes

Restart=always
RestartSec=10s

# Further restrict the API subtrees, as most services don't need these.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Restrict the permitted syscalls to a reasonable set used by common system services.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Required for AIPC, KV Storage
SupplementaryGroups=aipc kvstore graphic
ReadWritePaths=/var/lib/data/ace/aipc/ /var/lib/data/ace/kvstorage -/dev/dri

# Required for logging
ReadWritePaths=-/dev/socket -/dev/log
BindPaths=-/dev/socket -/dev/log

# AIPC over Binder
DeviceAllow=/dev/binder rw
BindPaths=-/dev/binder
ReadWritePaths=-/dev/binder

# graphics
DeviceAllow=/dev/ion rw
BindPaths=-/dev/ion
ReadWritePaths=-/dev/ion

DeviceAllow=/dev/dri/renderD128 rw
BindPaths=-/dev/dri/renderD128
ReadWritePaths=-/dev/dri/renderD128

DeviceAllow=/dev/dri/card0 rw
BindPaths=-/dev/dri/card0
ReadWritePaths=-/dev/dri/card0

DeviceAllow=/dev/hgsl rw
BindPaths=-/dev/hgsl
ReadWritePaths=-/dev/hgsl

DeviceAllow=/dev/hab rw
BindPaths=-/dev/hab
ReadWritePaths=-/dev/hab

# Fortifying the service
# PrivateNetwork=true        # Exposed due to VTrace.
CapabilityBoundingSet=none
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true

# State Directory (for Arcus config)
StateDirectory=data/usagestats

[Install]
WantedBy=multi-user.target
