#!/bin/sh

# TODO enable the lines below once we have support for getprop
# retrieve the product info from Android
# manufacturer=$(getprop ro.product.manufacturer Android)
# model=$(getprop ro.product.model Android)
# serial=$(getprop ro.serialno 0123456789ABCDEF)

manufacturer="Amazon, Inc."

#fallback if idme does not have serial number
DSN_PATH=$(cat /sys/firmware/devicetree/base/model)
model_name=$(echo ${DSN_PATH} | cut -d ' ' -f 3)
echo "DSN IS ${model_name}"
# Use serial number from IDME
IDME_SERIAL_PATH=/proc/idme/serial
DSN="Amazon ${model_name}"
if [ -e ${IDME_SERIAL_PATH} ]; then
        SERIAL_VAL=$(cat ${IDME_SERIAL_PATH})
        if [ "0" != "${SERIAL_VAL}" ]; then
                DSN=${SERIAL_VAL}
        fi
fi

if [ "$1" == "adb" ]; then
        mkdir -p /dev/pts
        if mount -t devpts none /dev/pts &> /dev/null ; then
          echo "devpts mounted"
        else
          echo "devpts mount failed"
          exit 1
        fi
        sleep 0.01

        MODULE="libcomposite"
        if modprobe "$MODULE" &> /dev/null ; then
          echo "module $MODULE is inserted"
        else
          echo "module $MODULE insertion failed"
          exit 1
        fi

        MODULE="usb_f_fs"
        if modprobe "$MODULE" &> /dev/null ; then
          echo "module $MODULE is inserted"
        else
          echo "module $MODULE insertion failed"
          exit 1
        fi

        MODULE="usb_f_acm"
        if modprobe "$MODULE" &> /dev/null ; then
          echo "module $MODULE is inserted"
        else
          echo "module $MODULE insertion failed"
          exit 1
        fi

        CONFIG_FS="configfs"
        CONFIG_FS_DIR="/sys/kernel/config"
        if grep -F " $CONFIG_FS " /proc/mounts > /dev/null; then
          echo "$CONFIG_FS is already mounted"
        else
          echo "Trying to mount configfs"
          if mount -t $CONFIG_FS none $CONFIG_FS_DIR &> /dev/null ; then
            echo "$CONFIG_FS is mounted on $CONFIG_FS_DIR"
          else
            echo "$CONFIG_FS mount failed"
            exit 1
          fi
        fi

        sleep 0.01
        mkdir -p /sys/kernel/config/usb_gadget/gadb
        sleep 0.01
        echo 0x0200 > /sys/kernel/config/usb_gadget/gadb/bcdUSB
        mkdir -p /sys/kernel/config/usb_gadget/gadb/strings/0x409
        echo 1 > /sys/kernel/config/usb_gadget/gadb/os_desc/use 1
        sleep 0.01

        echo "0x1949" > /sys/kernel/config/usb_gadget/gadb/idVendor
        echo "0x1949" > /sys/kernel/config/usb_gadget/gadb/idProduct
        echo ${DSN} > /sys/kernel/config/usb_gadget/gadb/strings/0x409/serialnumber
        echo $manufacturer > /sys/kernel/config/usb_gadget/gadb/strings/0x409/manufacturer
        echo "${model_name} BSP" >  /sys/kernel/config/usb_gadget/gadb/strings/0x409/product

        mkdir -p /sys/kernel/config/usb_gadget/gadb/functions/ffs.adb
        sleep 0.01
        mkdir -p /sys/kernel/config/usb_gadget/gadb/configs/b.1
        sleep 0.01
        mkdir -p /sys/kernel/config/usb_gadget/gadb/configs/b.1/strings/0x409
        sleep 0.01
        echo "ffs.adb" > /sys/kernel/config/usb_gadget/gadb/configs/b.1/strings/0x409/configuration
        ln -s /sys/kernel/config/usb_gadget/gadb/functions/ffs.adb /sys/kernel/config/usb_gadget/gadb/configs/b.1

        mkdir -p /dev/usb-ffs
        sleep 0.01
        mkdir -p /dev/usb-ffs/adb
        sleep 0.01
        /usr/bin/chsmack -a _ /dev/usb-ffs
        mount -o uid=5000,gid=5000,smackfsdef=User::Shell -t functionfs adb /dev/usb-ffs/adb
        /usr/bin/chsmack -a User::Shell /dev/usb-ffs/adb/ep0
        /usr/bin/chsmack -a User::Shell /dev/usb-ffs/adb/ep1
        /usr/bin/chsmack -a User::Shell /dev/usb-ffs/adb/ep2

        mkdir -p /sys/kernel/config/usb_gadget/gadb/functions/acm.usb0
        ln -s /sys/kernel/config/usb_gadget/gadb/functions/acm.usb0 /sys/kernel/config/usb_gadget/gadb/configs/b.1
elif [ "$1" == "post" ];then
        sleep 0.1
        echo "0x1" > /sys/kernel/config/usb_gadget/gadb/os_desc/b_vendor_code
        sleep 10
        echo "b1000000.usb" > /sys/kernel/config/usb_gadget/gadb/UDC
elif [ "$1" == "none" ];then
        sleep 1
        echo -n "none" > /sys/kernel/config/usb_gadget/gadb/UDC
        rm /sys/kernel/config/usb_gadget/gadb/configs/b.1/f*
fi

