#!/bin/bash
# Quick script to generate a process snapshot ACR dump
#
set -e

PROG=$(basename $0)

function err() {
	echo >&2 "[ERROR] $@"
}

function warn() {
	echo >&2 "[WARN] $@"
}

function fatal() {
	err $@
	exit 1
}

function info() {
	echo "[INFO] $@"
}

function help() {
    echo 'Tool to snapshot a process and generate an ACR dump

    Usage:
        pid2acr -p PID|ProcessName

    Required arguments:
        -p PID|process name: PID or process name to snapshot

    Optional arguments:
        -d DESTDIR: Destination directory to store the snapshot
        -s: Dump the snapshot script instead of executing it
        -l: Log the process backtrace to syslog
        -v: Verbose mode

    Example:
        pid2acr -p 12345
        pid2acr -p lcm_service
    '
}

function write_snapshot_script() {
    local script_file=$1
    local pid=$2

    local fname=${script_file%.*}
    local suffix=${script_file##*.}
    script_file=${fname}-$pid.$suffix
    info "Generating snapshot script to ${script_file}"

    rm -f $script_file
    cat >$script_file <<EOF
#!/bin/bash
# This script is generated by $PROG

set -e

SNAPSHOT_DIR=/tmp/snapshot-\$1
DESTDIR=$DESTDIR
rm -rf \$SNAPSHOT_DIR
mkdir -p \$SNAPSHOT_DIR
mkdir -p \$DESTDIR

pid2md \$1 \$SNAPSHOT_DIR/snapshot.dmp

process=\$(readlink /proc/\$1/exe)
if echo \$process | grep -q -e "/stem-init$"; then
    process=\$(cat /proc/\$1/cmdline | cut -d: -f 1)
fi

cat > \$SNAPSHOT_DIR/snapshot.acr <<EOF2
CrashType: SNAPSHOT
Process: \$process
CrashReason: PID2MD-SNAPSHOT

<acr rev=1>
<acr_os_release>
\$(cat /etc/os-release)
</acr_os_release>
<acr_pid_meminfo>
\$(/usr/bin/perfdump meminfo)
\$(/usr/bin/perfdump meminfo \$1)
</acr_pid_meminfo>
<minidump_stackwalk>
\$(minidump_stackwalk \$SNAPSHOT_DIR/snapshot.dmp 2>/dev/null)
</minidump_stackwalk>
<minidump_lz4_base64>
\$(lz4 -c \$SNAPSHOT_DIR/snapshot.dmp | base64)
</minidump_lz4_base64>
</acr>

EOF2

mv \$SNAPSHOT_DIR/snapshot.acr \$DESTDIR/pid\$1-snapshot.acr
rm -rf \$SNAPSHOT_DIR

EOF
    chmod a+x $script_file
    TEMPSCRIPT=$script_file
}

function check_pid_exist() {
    local pid=$1

    local pid_list=$(ps -e | grep $pid | awk '{print $2}')
    if [ "$pid_list" == "" ]; then
        fatal "PID $pid does not exist"
    fi
}

function generate_process_bt() {
    # By default, we would only look for Thread 0
    local acr_file=$1
    local thread=0
    local numthread=1
    local proc=$(grep "Process:" $acr_file | awk '{print $2}')
    local msg="pid2acr;proc=$proc;bt=thd$thread"
    # Dump thread info
    while [ $thread -lt $numthread ]; do
        sed "/Thread $thread/,/^$/!d;/^$/q" $acr_file | \
        { while read i
        do
            re='^[:space:]*[0-9]+ '
            if [[ $i =~ $re ]]; then
                frame=$(echo $i | awk '{print $1}')
                file=$(echo $i | awk '{print $2}')
                addr=$(echo $i | awk '{print $4}')
                msg="${msg},frm${frame}=${file}:${addr}"
            fi
        done
            logger -t $PROG -p local0.info "$msg"
        }
        thread=$(( $thread + 1 ))
    done
}

VERBOSE=
TEMPSCRIPT=/tmp/pid2acr.sh
DESTDIR=/tmp
while getopts "d:hlp:sv" opt; do
    case ${opt} in
    d)
        DESTDIR=$OPTARG
        ;;
    l)
        LOG="true"
        ;;
    p)
        PID=$OPTARG
        ;;
    v)
        VERBOSE="true"
        ;;
    s)
        NODUMP="true"
        ;;
    h)
        help
        exit
        ;;
    \?)
        echo "Invalid option: $OPTARG" 1>&2
        help
        exit
        ;;
    esac
done

shift $((OPTIND - 1))

[ "$VERBOSE" ] && set -x

# Must have a PID
if [ ! "$PID" ]; then
    fatal "Must provide a PID or process name"
fi

# Figure out PID
# check if user specified a name -> resolve to pid
if [[ ! "$PID" =~ ^[0-9]+$ ]]; then
    PROCESS_NAME=$PID

    # Can't handle with ambiguity
    NUMPROC=$(pgrep $PROCESS_NAME | wc -l | tr -d '\r\n')
    if [ "$NUMPROC" -gt 1 ]; then
        error "Error: More than one matching process name: $PROCESS_NAME, try specify pid directly"
        echo "Matched processes:"
        pgrep -a $PROCESS_NAME
        exit 1
    fi

    PID=$(pgrep $PROCESS_NAME | tr -d '\r\n')
    if [ -z "$PID" ]; then
        fatal "Error: couldn't resolve pid by process name: $PROCESS_NAME"
    else
        info "Resolved pid for $PROCESS_NAME is $PID"
    fi
fi

check_pid_exist $PID

info "Snapshotting process $PID"

# Write temporary script to snapshot the process
write_snapshot_script $TEMPSCRIPT $PID

# Execute the script
if [ "$NODUMP" ]; then
    cat $TEMPSCRIPT
else
    $TEMPSCRIPT $PID
    if [ "$LOG" ]; then
        generate_process_bt $DESTDIR/pid$PID-snapshot.acr
    fi
    info "PID-SNAPSHOT: $DESTDIR/pid$PID-snapshot.acr"
fi

rm -f $TEMPSCRIPT

