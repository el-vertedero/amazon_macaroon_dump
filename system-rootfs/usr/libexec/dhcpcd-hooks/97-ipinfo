# This script runs last, after all network configuration
# has completed. It sets a property to let the framework
# know that setting up the interface is complete.

ipinfo_dir="/var/run"
file="$ipinfo_dir/ipinfo_$interface"
ipv6_file="$ipinfo_dir/ipv6info_$interface"

case "${reason}" in
BOUND|INFORM|REBIND|REBOOT|RENEW|TIMEOUT|STATIC)
    # every time when ip changed, a new info file will be created.
    [ -f "$file" ] && rm -f "$file"

    printf "# Auto generated by script\n\n" >> "$file"
    chmod 664 "$file"
    
    printf "ipaddress %s\r\n" "${new_ip_address}" >> "$file"
    printf "mask %s\r\n" "${new_subnet_mask}" >> "$file"
    printf "gateway %s\r\n" "${new_routers%% *}" >> "$file"
    printf "nameservers %s\r\n" "${new_domain_name_servers}" >> "$file"
    printf "leasetime %s\r\n" "${new_dhcp_lease_time}" >> "$file"
    printf "renewtime %s\r\n" "${new_dhcp_renewal_time}" >> "$file"
    printf "rebindtime %s\r\n" "${new_dhcp_rebinding_time}" >> "$file"

    count=1
    for x in ${new_domain_name_servers}; do
        if [ $count -lt 4 ]; then
            printf "dns${count} %s\r\n" ${x} >> "$file"
            count=$(($count + 1))
        fi
    done

    printf "result %s\r\n" "ok" >> "$file"
    printf "reason %s\r\n" "${reason}" >> "$file"
    ;;


BOUND6|RENEW6|REBIND6|REBOOT6|INFORM6)
    [ -f "$ipv6_file" ] && rm -f "$ipv6_file"

    printf "# Auto generated by script expire\n\n\n" >> "$ipv6_file"
    chmod 664 "$ipv6_file"

    count=1
    for x in ${new_dhcp6_name_servers}; do
        printf "dns${count} %s\r\n" ${x} >> "$ipv6_file"
        count=$(($count + 1))
    done

    printf "result %s\r\n" "ok" >> "$ipv6_file"
    printf "reason %s\r\n" "${reason}" >> "$ipv6_file"
    ;;

EXPIRE6)
    [ -f "$ipv6_file" ] && rm -f "$ipv6_file"

    printf "# Auto generated by script expire\n\n\n" >> "$ipv6_file"
    chmod 664 "$ipv6_file"

    printf "result %s\r\n" "failed" >> "$file"
    printf "reason %s\r\n" "${reason}" >> "$file"
    ;;


EXPIRE|FAIL|IPV4LL|STOP|NAK)
    [ -f "$file" ] && rm -f "$file"

    printf "# Auto generated by script expire\n\n\n" >> "$file"
    chmod 664 "$file"
    
    printf "ipaddress %s\r\n" "0.0.0.0" >> "$file"
    printf "gateway %s\r\n" "0.0.0.0" >> "$file"
    printf "result %s\r\n" "failed" >> "$file"
    printf "reason %s\r\n" "${reason}" >> "$file"
    ;;

esac

