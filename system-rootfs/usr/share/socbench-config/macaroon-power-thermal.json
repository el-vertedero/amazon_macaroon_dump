{
    "model_name": "macaroon",
    "mem_stats": "/proc/meminfo",
    "cycles_to_bytes": 16,
    "hwmon_sensors": [
        {
            "name": "pvt_a55",
            "type": "temp",
            "path": "/sys/class/thermal/thermal_zone0/temp"
        },
        {
            "name": "pvt_mem_ss",
            "type": "temp",
            "path": "/sys/class/thermal/thermal_zone1/temp"
        },
        {
            "name": "pvt_audio",
            "type": "temp",
            "path": "/sys/class/thermal/thermal_zone2/temp"
        },
        {
            "name": "main_pmic_die_t",
            "type": "temp",
            "path": "/sys/class/thermal/thermal_zone10/temp"
        }
    ],
    "bsp_stats": [
        {
            "name": "board_power",
            "type": "power",
            "path": "/sys/class/hwmon/hwmon1/power1_input"
        }
    ],
    "process_stats": [
        {
            "name": "ps_cpu",
            "param":["socbench", "syslogd", "acenna_service", "lcm_service", "btmanagerd", "smartboxd", "PuffinApp"],
            "path": "/sys/%d/stat"
        }
    ]
}
